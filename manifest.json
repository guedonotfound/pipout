{
  "manifest_version": 3,
  "name": "Pipout",
  "version": "1.0.0",
  "description": "Botão de Picture-in-Picture na borda dos vídeos, com opção de abrir sozinho ao trocar de aba.",
  "homepage_url": "https://github.com/guedonotfound/pipout",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pipout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
